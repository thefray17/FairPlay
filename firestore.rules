rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to validate allowed top-level keys, field types, and sizes for session documents
    function isValidSessionWrite() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'id', 'clubId', 'config', 'players', 'rounds', 'upcomingMatches',
        'openPlay', 'ownerUid', 'organizerToken', 'updatedAt', 'createdAt', 'deviceOrigin'
      ])
      && data.id is string
      && data.id.size() > 0
      && data.id.size() <= 64
      && data.organizerToken is string
      && data.organizerToken.size() > 0
      && data.organizerToken.size() <= 128
      && (!('clubId' in data) || (data.clubId is string && data.clubId.size() <= 64))
      && (!('updatedAt' in data) || data.updatedAt is number)
      && (!('createdAt' in data) || data.createdAt is number)
      && (!('config' in data) || data.config is map)
      && (!('players' in data) || data.players is list)
      && (!('rounds' in data) || data.rounds is list)
      && (!('upcomingMatches' in data) || data.upcomingMatches is list)
      && (!('openPlay' in data) || data.openPlay is map)
      && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
      && (!('deviceOrigin' in data) || (data.deviceOrigin is string && data.deviceOrigin.size() <= 256));
    }

    // Sessions: Publicly readable for spectators/players with code; strictly protected writes
    match /sessions/{sessionId} {
      // Reads stay open so players can view a session by PIN without logging in
      allow read: if true;

      // Writes that CREATE a new session document (resource == null)
      allow create: if isValidSessionWrite()
                    && request.resource.data.organizerToken is string
                    && request.resource.data.organizerToken.size() > 0;

      // Writes to an EXISTING session document are only allowed if organizerToken matches the stored token
      allow update: if isValidSessionWrite()
                    && resource.data.organizerToken != null
                    && request.resource.data.organizerToken == resource.data.organizerToken;

      // Deletions: authenticated owner only
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Helper to validate allowed keys and fields for club/squad documents
    function isValidClubWrite() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'id', 'name', 'code', 'createdByUid', 'memberProfileIds', 'sessionIds',
        'createdAt', 'updatedAt', 'description', 'sport'
      ])
      && data.id is string
      && data.id.size() > 0
      && data.id.size() <= 64
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 100
      && data.code is string
      && data.code.size() >= 4
      && data.code.size() <= 16
      && (!('createdByUid' in data) || (data.createdByUid is string && data.createdByUid.size() <= 128))
      && (!('memberProfileIds' in data) || data.memberProfileIds is list)
      && (!('sessionIds' in data) || data.sessionIds is list)
      && (!('createdAt' in data) || data.createdAt is number)
      && (!('updatedAt' in data) || data.updatedAt is number)
      && (!('description' in data) || (data.description is string && data.description.size() <= 500))
      && (!('sport' in data) || (data.sport is string && data.sport.size() <= 32));
    }

    // Clubs collection:
    // Reads stay public so squad members can join via 4-digit code and view squad info
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isValidClubWrite();
      allow update: if isValidClubWrite();
      allow delete: if request.auth != null && resource.data.createdByUid == request.auth.uid;
    }

    // User accounts & organizer profiles:
    // Scoped to authenticated users for now. Once real account auth ships,
    // this should be scoped further to request.auth.uid == userId / profile ownership.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Player profiles across sessions:
    // Reads are public so squad members and spectators can view cross-session stats
    match /playerProfiles/{profileId} {
      allow read: if true;
      allow write: if request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 64;
    }
  }
}


